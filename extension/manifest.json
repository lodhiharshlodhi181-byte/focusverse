{
  "manifest_version": 3,
  "name": "FocusVerse - Productivity Tracker",
  "version": "1.0.0",
  "description": "Track your productivity and maintain your anime avatar",
  "permissions": [
    "tabs",
    "activeTab",
    "scripting",
    "storage",
    "idle"
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "http://localhost:5000/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "FocusVerse"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
